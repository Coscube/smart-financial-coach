{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker: Start PostgreSQL",
      "type": "shell",
      "command": "docker compose -f backend/scripts/local-dev.yml up -d postgres",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "runOptions": {
        "runOn": "default"
      }
    },
    {
      "label": "Docker: Stop PostgreSQL",
      "type": "shell",
      "command": "docker compose -f backend/scripts/local-dev.yml down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Docker: View Logs",
      "type": "shell",
      "command": "docker compose -f backend/scripts/local-dev.yml logs -f postgres",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Docker: Reset Database",
      "type": "shell",
      "command": "docker compose -f backend/scripts/local-dev.yml down -v && docker compose -f backend/scripts/local-dev.yml up -d postgres",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Backend: Install Dependencies",
      "type": "shell",
      "command": "poetry install",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Backend: Run Migrations",
      "type": "shell",
      "command": "poetry run python -c \"from src.database import init_db; import asyncio; asyncio.run(init_db())\"",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "dependsOn": ["Docker: Start PostgreSQL"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Backend: Run Tests",
      "type": "shell",
      "command": "poetry run pytest -v",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Frontend: Install Dependencies",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Frontend: Run Tests",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Full Stack: Start All",
      "dependsOn": ["Docker: Start PostgreSQL"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "runOptions": {
        "runOn": "default"
      }
    }
  ]
}
