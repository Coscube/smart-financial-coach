{
  "version": "2.0.0",
  "options": {
    "env": {
      "Path": "${env:Path};C:\\Program Files\\nodejs"
    }
  },
  "tasks": [
    {
      "label": "dev",
      "type": "shell",
      "command": "$env:Path = [System.Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [System.Environment]::GetEnvironmentVariable('Path','User'); npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in \\d+ ms"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "npm: build",
      "type": "shell",
      "command": "$env:Path = [System.Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [System.Environment]::GetEnvironmentVariable('Path','User'); npm run build",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "npm: test",
      "type": "shell",
      "command": "$env:Path = [System.Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [System.Environment]::GetEnvironmentVariable('Path','User'); npm run test",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "npm: lint",
      "type": "shell",
      "command": "$env:Path = [System.Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [System.Environment]::GetEnvironmentVariable('Path','User'); npm run lint",
      "problemMatcher": ["$eslint-stylish"]
    }
  ]
}
