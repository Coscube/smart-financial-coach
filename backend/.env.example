# Application Settings
APP_NAME=Smart Financial Coach
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production

# Server Settings
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Database Settings (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/financial_coach
DATABASE_SYNC_URL=postgresql://postgres:password@localhost:5432/financial_coach

# For AWS RDS (uncomment and configure for production)
# DATABASE_URL=postgresql+asyncpg://username:password@your-rds-endpoint.region.rds.amazonaws.com:5432/financial_coach

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Logging
LOG_LEVEL=INFO

# ============================================
# AI / OpenAI Settings for Financial Coach
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
# Or use GitHub Copilot API key if you have access
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model to use (options: gpt-4o-mini, gpt-4o, gpt-4-turbo, gpt-3.5-turbo)
# gpt-4o-mini is recommended for cost-effectiveness
OPENAI_MODEL=gpt-4o-mini

# Optional: Custom base URL for OpenAI-compatible APIs
# Leave empty for standard OpenAI API
# Examples:
# - Azure OpenAI: https://your-resource.openai.azure.com/openai/deployments/your-deployment
# - Local LLM: http://localhost:1234/v1
OPENAI_BASE_URL=
